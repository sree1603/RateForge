# Copy to .env for local use. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Used when running the app outside Docker (Compose overrides these for the api service).
DATABASE_URL=postgresql+asyncpg://rateforge:rateforge@localhost:5432/rateforge
REDIS_URL=redis://localhost:6379/0

# Secret used to HMAC API keys. Changing it invalidates every existing key.
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_HMAC_SECRET=dev-only-hmac-secret-change-me-0123456789abcdef

# Sent in the X-Admin-Token header to use the admin endpoints.
ADMIN_TOKEN=dev-only-admin-token-change-me

# Optional rate-limiting settings (defaults shown).
# RATE_LIMIT_FAILURE_MODE=closed   # "closed": 503 when Redis is down; "open": allow unlimited
# REDIS_TIMEOUT_SECONDS=0.5
# REDIS_MAX_CONNECTIONS=100
# POLICY_CACHE_TTL_SECONDS=30
# USAGE_QUEUE_SIZE=10000
# USAGE_BATCH_SIZE=100
# USAGE_FLUSH_INTERVAL_SECONDS=1.0
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=5
# DB_CONNECT_TIMEOUT_SECONDS=5
# ROUTE_CACHE_TTL_SECONDS=5
# METRICS_PUBLIC=false
